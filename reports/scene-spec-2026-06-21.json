{
  "date": "2026-06-21",
  "topic": "OpenMontage, an agentic video-production system that retrieves real archive footage and edits a timeline instead of animating stills",
  "creator_handle": "@calesthioailabs",
  "project_url": "https://github.com/calesthio/OpenMontage",

  "design": {
    "brand_slug": "voltagent",
    "aesthetic_slug": "voltagent",
    "framework": "SCHEMATIC",
    "audio_palette": "electronic",
    "held_subject": "OpenMontage",

    "tokens": {
      "canvas": "#050507",
      "ink": "#F2F2F2",
      "ink_muted": "#8B949E",
      "accent": "#00D992",
      "hairline": "#3D3A39"
    },

    "fonts": {
      "display": "Inter",
      "body": "Inter",
      "italic": "Inter"
    },

    "typography": {
      "display_weight": 600,
      "body_weight": 400,
      "letter_spacing_em": -0.01,
      "case": "preserve",
      "italic_descriptors": false
    },

    "motion": {
      "register": "fade",
      "scene_in_s": 0.30,
      "scene_out_s": 0.20,
      "stagger_s": 0.20
    },

    "layout": {
      "padding_pct": 7,
      "rule_thickness_px": 1,
      "stage_radius_px": 8
    },

    "texture": {
      "grain": 0.05,
      "vignette": 0.24,
      "halation": 0.06,
      "lighting_arc": 0.26
    },

    "accent_contrast_min": 4.5
  },

  "scenes": [
    {
      "template": "title",
      "headline": "OpenMontage",
      "eyebrow": "an agent runs the edit bay",
      "camera": "push_in",
      "duration_s": 3.0
    },
    {
      "template": "diagram",
      "eyebrow": "INSIDE THE PIPELINE",
      "nodes": [
        {"label": "Prompt",    "x": 12, "y": 34},
        {"label": "Research",  "x": 36, "y": 34},
        {"label": "Archives",  "x": 60, "y": 34, "accent": true},
        {"label": "Edit bay",  "x": 40, "y": 70},
        {"label": "Final cut", "x": 82, "y": 62, "accent": true, "filled": true}
      ],
      "edges": [
        {"from": 0, "to": 1},
        {"from": 1, "to": 2},
        {"from": 2, "to": 3},
        {"from": 3, "to": 4, "accent": true}
      ],
      "camera": "orbit",
      "duration_s": 4.5
    },
    {
      "template": "terminal",
      "title": "openmontage make a doc",
      "lines": [
        {"text": "openmontage make \"3 minutes on Saturn\"", "prompt": true},
        {"text": "searching Archive.org NASA Wikimedia", "prompt": false},
        {"text": "retrieved 24 real motion clips", "prompt": false},
        {"text": "cut and rendered from live footage", "prompt": false}
      ],
      "accent_idx": 3,
      "camera": "parallax_drift",
      "duration_s": 3.5
    },
    {
      "template": "two_line",
      "lines": ["Stock tools fake it.", "This edits real film."],
      "accent_idx": 1,
      "camera": "ken_burns",
      "duration_s": 3.0
    },
    {
      "template": "fix",
      "primary": "Describe the cut.",
      "secondary": "The agent ships it.",
      "emphasize": true,
      "camera": "crash_zoom",
      "duration_s": 3.0
    },
    {
      "template": "close",
      "primary": "A whole crew.",
      "accent": "One agent loop.",
      "subtitle": "research to render, no editor in the room",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.5
    }
  ]
}
