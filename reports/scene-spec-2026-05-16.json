{
  "date": "2026-05-16",
  "topic": "career-ops, the job hunt run from a coding CLI",
  "creator_handle": "@santifer",
  "project_url": "https://github.com/santifer/career-ops",

  "design": {
    "brand_slug": "linear.app",
    "aesthetic_slug": "mono",
    "framework": "CLASSIC",
    "audio_palette": "ambient",
    "held_subject": "career-ops",
    "tokens":   {"canvas": "#010102", "ink": "#f7f8f8", "ink_muted": "#8a8f98", "accent": "#5e6ad2", "hairline": "#23252a"},
    "fonts":    {"display": "Inter", "body": "Inter", "italic": "Inter"},
    "typography": {"display_weight": 600, "body_weight": 400, "letter_spacing_em": -0.02, "case": "preserve", "italic_descriptors": false},
    "motion":   {"register": "fade", "scene_in_s": 0.32, "scene_out_s": 0.22, "stagger_s": 0.22},
    "layout":   {"padding_pct": 7, "rule_thickness_px": 1, "stage_radius_px": 8},
    "texture":  {"grain": 0.04, "vignette": 0.20, "halation": 0.05, "lighting_arc": 0.26},
    "accent_contrast_min": 3.0
  },

  "scenes": [
    {
      "template": "title",
      "headline": "career-ops",
      "eyebrow": "the job hunt, run from a CLI",
      "camera": "push_in",
      "duration_s": 3.0
    },
    {
      "template": "big_number",
      "numeral": "45k",
      "caption": "stars in six weeks",
      "sub": "first commit, April 4",
      "camera": "ken_burns",
      "duration_s": 3.5
    },
    {
      "template": "diagram",
      "eyebrow": "the scoring loop",
      "nodes": [
        {"label": "job offer",   "x": 50, "y": 15},
        {"label": "score A-F",   "x": 82, "y": 50},
        {"label": "tailored CV", "x": 50, "y": 85},
        {"label": "your call",   "x": 18, "y": 50, "accent": true}
      ],
      "edges": [
        {"from": 0, "to": 1},
        {"from": 1, "to": 2},
        {"from": 2, "to": 3, "accent": true},
        {"from": 3, "to": 0, "style": "dashed"}
      ],
      "camera": "orbit",
      "duration_s": 4.5
    },
    {
      "template": "fix",
      "primary": "You decide.",
      "secondary": "It won't hit submit.",
      "emphasize": true,
      "camera": "push_in",
      "duration_s": 3.5
    },
    {
      "template": "three_line",
      "lines": ["fourteen skill modes.", "parallel sub-agents.", "one command center."],
      "accent_idx": 2,
      "camera": "parallax_drift",
      "duration_s": 3.0
    },
    {
      "template": "close",
      "primary": "Built for his hunt.",
      "accent": "Open for yours.",
      "subtitle": "he landed the role, then shipped it.",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.5
    }
  ]
}
