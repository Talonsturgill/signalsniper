{
  "date": "2026-06-27",
  "topic": "Weave Router, a model router that picks the cheapest capable model for every request with a tiny on-box embedder in under 50ms",
  "creator_handle": "@WorkWeave",
  "project_url": "https://github.com/workweave/router",

  "design": {
    "brand_slug": null,
    "aesthetic_slug": "gallery",
    "framework": "SCHEMATIC",
    "held_subject": "router",

    "tokens": {
      "canvas": "#FFFFFF",
      "ink": "#0E0E0F",
      "ink_muted": "#7B7B7E",
      "accent": "#1B5BFF",
      "hairline": "#E5E5E8"
    },

    "fonts": {
      "display": "IBMPlexSerif",
      "body": "Inter",
      "italic": "IBMPlexSerif"
    },

    "typography": {
      "display_weight": 700,
      "body_weight": 400,
      "letter_spacing_em": -0.018,
      "case": "preserve",
      "italic_descriptors": true
    },

    "motion": {
      "register": "fade",
      "scene_in_s": 0.42,
      "scene_out_s": 0.27,
      "stagger_s": 0.30
    },

    "layout": {
      "padding_pct": 9,
      "rule_thickness_px": 1,
      "stage_radius_px": 4
    },

    "texture": {
      "grain": 0.03,
      "vignette": 0.10,
      "halation": 0.04,
      "lighting_arc": 0.22
    },

    "audio_palette": "acoustic",
    "accent_contrast_min": 4.5
  },

  "scenes": [
    {
      "template": "title",
      "headline": "One door, every model",
      "eyebrow": "the prompt picks the model",
      "camera": "push_in",
      "duration_s": 3.0
    },
    {
      "template": "diagram",
      "eyebrow": "PICKED ON YOUR BOX",
      "nodes": [
        {"label": "your prompt", "x": 14, "y": 50},
        {"label": "on-box embedder", "x": 50, "y": 50, "accent": true, "filled": true},
        {"label": "Claude", "x": 86, "y": 20},
        {"label": "OpenAI", "x": 86, "y": 50},
        {"label": "Gemini", "x": 86, "y": 80}
      ],
      "edges": [
        {"from": 0, "to": 1},
        {"from": 1, "to": 2, "accent": true},
        {"from": 1, "to": 3, "accent": true},
        {"from": 1, "to": 4, "accent": true}
      ],
      "camera": "orbit",
      "duration_s": 4.5
    },
    {
      "template": "two_line",
      "lines": ["It decides in a blink.", "Under 50ms."],
      "accent_idx": 1,
      "camera": "parallax_drift",
      "duration_s": 2.5
    },
    {
      "template": "big_number",
      "numeral": "40-70%",
      "caption": "off the inference bill",
      "sub": "same answers, smaller invoice",
      "camera": "ken_burns",
      "duration_s": 3.0
    },
    {
      "template": "fix",
      "primary": "You stop choosing.",
      "secondary": "It already chose.",
      "emphasize": true,
      "camera": "crash_zoom",
      "duration_s": 3.5
    },
    {
      "template": "close",
      "primary": "Andrew built it.",
      "accent": "You just point.",
      "subtitle": "Claude, Codex, Cursor, opencode supported.",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.5
    }
  ]
}
