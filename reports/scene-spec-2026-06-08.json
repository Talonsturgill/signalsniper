{
  "date": "2026-06-08",
  "topic": "Agent Reach, the not-a-framework internet read layer for AI agents",
  "creator_handle": "@Neo_Reidlab",
  "project_url": "https://github.com/Panniantong/Agent-Reach",

  "design": {
    "brand_slug": null,
    "aesthetic_slug": "subway-chrome",
    "framework": "SCHEMATIC",
    "audio_palette": "electronic",
    "held_subject": "agent-reach",
    "accent_contrast_min": 4.5,

    "tokens": {
      "canvas": "#15171A",
      "ink": "#F4F6FA",
      "ink_muted": "#8B95A6",
      "accent": "#7DD9FF",
      "hairline": "#262A30"
    },
    "fonts": {
      "display": "JetBrainsMono",
      "body": "Inter",
      "italic": "Inter"
    },
    "typography": {
      "display_weight": 600,
      "body_weight": 400,
      "letter_spacing_em": -0.015,
      "case": "preserve",
      "italic_descriptors": false
    },
    "motion": {
      "register": "fade",
      "scene_in_s": 0.32,
      "scene_out_s": 0.22,
      "stagger_s": 0.22
    },
    "layout": {
      "padding_pct": 7,
      "rule_thickness_px": 1,
      "stage_radius_px": 4
    },
    "texture": {
      "grain": 0.04,
      "vignette": 0.20,
      "halation": 0.05,
      "lighting_arc": 0.34
    }
  },

  "scenes": [
    {
      "template": "title",
      "headline": "Agent Reach",
      "eyebrow": "the read layer for agents",
      "camera": "push_in",
      "duration_s": 3.0
    },
    {
      "template": "diagram",
      "eyebrow": "HOW IT REACHES OUT",
      "nodes": [
        {"label": "your agent", "x": 50, "y": 50, "accent": true, "filled": true},
        {"label": "X / Reddit", "x": 20, "y": 22},
        {"label": "YouTube", "x": 80, "y": 22},
        {"label": "GitHub", "x": 20, "y": 78},
        {"label": "Bilibili", "x": 80, "y": 78}
      ],
      "edges": [
        {"from": 0, "to": 1, "accent": true},
        {"from": 0, "to": 2, "accent": true},
        {"from": 0, "to": 3, "accent": true},
        {"from": 0, "to": 4, "accent": true}
      ],
      "camera": "orbit",
      "duration_s": 4.5
    },
    {
      "template": "two_line",
      "lines": ["Most kits hand you", "a framework."],
      "accent_idx": 1,
      "camera": "parallax_drift",
      "duration_s": 3.0
    },
    {
      "template": "fix",
      "primary": "It hands you glue.",
      "secondary": "then steps aside.",
      "emphasize": true,
      "camera": "crash_zoom",
      "duration_s": 3.5
    },
    {
      "template": "big_number",
      "numeral": "$0",
      "caption": "in API fees",
      "sub": "fourteen surfaces, one CLI",
      "camera": "ken_burns",
      "duration_s": 3.5
    },
    {
      "template": "close",
      "primary": "Reach, anywhere.",
      "accent": "no wrappers.",
      "subtitle": "plumbing, not a platform.",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.5
    }
  ]
}
