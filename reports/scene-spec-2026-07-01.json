{
  "date": "2026-07-01",
  "topic": "herdr, the terminal agent multiplexer that shows every coding agent's state at a glance",
  "creator_handle": "@ogulcancelik",
  "project_url": "https://github.com/ogulcancelik/herdr",

  "design": {
    "brand_slug": "linear.app",
    "aesthetic_slug": "linear.app",
    "framework": "RECEIPT",
    "held_subject": "herdr",

    "tokens": {
      "canvas": "#010102",
      "ink": "#f7f8f8",
      "ink_muted": "#8a8f98",
      "accent": "#828fff",
      "hairline": "#23252a"
    },

    "fonts": {
      "display": "Inter",
      "body": "Inter",
      "italic": "Inter"
    },

    "typography": {
      "display_weight": 700,
      "body_weight": 400,
      "letter_spacing_em": -0.02,
      "case": "preserve",
      "italic_descriptors": false
    },

    "motion": {
      "register": "fade",
      "scene_in_s": 0.36,
      "scene_out_s": 0.24,
      "stagger_s": 0.24
    },

    "layout": {
      "padding_pct": 8,
      "rule_thickness_px": 1,
      "stage_radius_px": 8
    },

    "texture": {
      "grain": 0.04,
      "vignette": 0.16,
      "halation": 0.03,
      "lighting_arc": 0.20
    },

    "audio_palette": "electronic",
    "accent_contrast_min": 4.5
  },

  "scenes": [
    {
      "template": "title",
      "headline": "herdr",
      "eyebrow": "a multiplexer for your coding agents",
      "camera": "orbit",
      "duration_s": 3.0
    },
    {
      "template": "big_number",
      "numeral": "26",
      "caption": "coding agents, one terminal",
      "sub": "claude code, codex, cursor, and more",
      "camera": "ken_burns",
      "duration_s": 3.0
    },
    {
      "template": "terminal",
      "title": "herdr",
      "lines": [
        {"text": "herdr up"},
        {"text": "1  claude code    working", "prompt": false},
        {"text": "2  codex          blocked", "prompt": false},
        {"text": "3  cursor agent   done", "prompt": false}
      ],
      "camera": "parallax_drift",
      "duration_s": 4.0
    },
    {
      "template": "big_number",
      "numeral": "10MB",
      "caption": "one rust binary",
      "sub": "no electron. no wrapper. no telemetry.",
      "camera": "ken_burns",
      "duration_s": 3.0
    },
    {
      "template": "fix",
      "primary": "One glance.",
      "secondary": "Blocked, working, done",
      "emphasize": true,
      "camera": "push_in",
      "duration_s": 3.5
    },
    {
      "template": "close",
      "primary": "Ship in",
      "accent": "parallel.",
      "subtitle": "every agent you run, in one place.",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.5
    }
  ]
}
