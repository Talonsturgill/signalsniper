{
  "date": "2026-07-07",
  "project": "claude-video",
  "project_url": "https://github.com/bradautomates/claude-video",
  "design": {
    "framework": "CLASSIC",
    "tokens": {
      "canvas": "#322E3B",
      "ink": "#EFEDF5",
      "accent": "#CBA0FF",
      "ink_muted": "#8B84A0",
      "hairline": "#423E4C"
    },
    "fonts": {
      "display": "JetBrainsMono",
      "body": "Inter",
      "italic": "Inter"
    },
    "typography": {
      "display_weight": 600,
      "body_weight": 400,
      "letter_spacing_em": -0.01,
      "case": "lower",
      "italic_descriptors": false
    },
    "motion": {
      "register": "fade",
      "scene_in_s": 0.32,
      "scene_out_s": 0.22,
      "stagger_s": 0.16
    },
    "layout": {
      "padding_pct": 6,
      "rule_thickness_px": 1,
      "stage_radius_px": 4
    },
    "texture": {
      "grain": 0.05,
      "vignette": 0.2,
      "halation": 0.03,
      "lighting_arc": 0.22
    },
    "background": {
      "style": "grid"
    },
    "transition_style": "push",
    "foley_style": "tapestop_drop",
    "audio_palette": "electronic",
    "accent_contrast_min": 3.5,
    "audio_track": "Werq.mp3",
    "beat": {
      "bpm": 123.0,
      "offset_s": 30.0,
      "aligned": true,
      "median_drift_ms": 95.1
    }
  },
  "scenes": [
    {
      "template": "screen_capture",
      "camera": "push_in",
      "duration_s": 4.05,
      "title": "claude-video",
      "url": "youtu.be/demo  ask 0:30",
      "lines": [
        "it reads the title",
        "never the video"
      ],
      "sheen": true,
      "illustrates": "the blind window enacts 'reads the title, never the video' -- an address holds a link but the body admits it only sees the title"
    },
    {
      "template": "terminal",
      "camera": "rack_focus",
      "duration_s": 3.83,
      "prompt_char": ">",
      "title": "install in one line",
      "lines": [
        {
          "text": "/plugin install watch@claude-video",
          "prompt": true
        }
      ],
      "sheen": true,
      "illustrates": "one documented command, typed, enacts easy install -- the watch skill drops in with a single line"
    },
    {
      "template": "montage",
      "camera": "parallax_drift",
      "duration_s": 4.09,
      "eyebrow": "frames, near-dupes dropped",
      "tiles": [
        "0:00",
        "0:06",
        "0:14",
        "dup",
        "0:25",
        "0:37",
        "dup",
        "0:52"
      ],
      "illustrates": "the mosaic of timestamped frames with 'dup' tiles enacts 'near-dupes dropped' -- the dedup is on screen"
    },
    {
      "template": "panes",
      "camera": "ken_burns",
      "duration_s": 4.06,
      "eyebrow": "free captions first",
      "panes": [
        {
          "name": "captions",
          "lines": [
            "yt-dlp"
          ],
          "state": "done"
        },
        {
          "name": "frames",
          "lines": [
            "ffmpeg"
          ],
          "state": "working"
        },
        {
          "name": "audio",
          "lines": [
            "whisper"
          ],
          "state": "idle",
          "flip_to": "done",
          "flip_at": 0.6
        }
      ],
      "sheen": true,
      "illustrates": "three running panes (captions done, frames working, audio filling in) enact 'captions first, then whisper' -- the pipeline order shown as live status"
    },
    {
      "template": "screen_capture",
      "camera": "dolly_up",
      "duration_s": 4.34,
      "title": "claude, grounded",
      "url": "youtu.be/demo  at 0:30",
      "lines": [
        "at 0:30 he opens the terminal",
        "claude saw it, not the title"
      ],
      "money_shot": true,
      "emphasize": true,
      "sheen": true,
      "illustrates": "the answer revealing in the window enacts 'claude saw it, not the title' -- Claude cites a second it could only know by seeing"
    },
    {
      "template": "big_number",
      "camera": "push_in",
      "duration_s": 3.72,
      "numeral": "5,000",
      "caption": "stars in days",
      "sub": "and climbing fast",
      "illustrates": "the number climbing to 5,000 enacts 'stars in days' -- the receipt shown as motion, once"
    },
    {
      "template": "flash",
      "camera": "tilt_reveal",
      "duration_s": 3.2,
      "word": "now it watches",
      "caption": "claude-video",
      "illustrates": "the bright violet button 'now it watches' buttons the thesis and rhymes the blind open"
    }
  ]
}
