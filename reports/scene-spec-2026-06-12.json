{
  "date": "2026-06-12",
  "topic": "cua, open-source infrastructure for Computer-Use Agents",
  "creator_handle": "@francedot",
  "project_url": "https://github.com/trycua/cua",

  "design": {
    "brand_slug": "cursor",
    "aesthetic_slug": "cursor",
    "framework": "CLASSIC",
    "audio_palette": "acoustic",
    "held_subject": "cua",
    "accent_contrast_min": 3.5,

    "tokens": {
      "canvas": "#f7f7f4",
      "ink": "#26251e",
      "ink_muted": "#807d72",
      "accent": "#d04200",
      "hairline": "#cfcdc4"
    },
    "fonts": {
      "display": "Inter",
      "body": "Inter",
      "italic": "Inter"
    },
    "typography": {
      "display_weight": 500,
      "body_weight": 400,
      "letter_spacing_em": -0.02,
      "case": "preserve",
      "italic_descriptors": false
    },
    "motion": {
      "register": "fade",
      "scene_in_s": 0.40,
      "scene_out_s": 0.27,
      "stagger_s": 0.27
    },
    "layout": {
      "padding_pct": 9,
      "rule_thickness_px": 1,
      "stage_radius_px": 12
    },
    "texture": {
      "grain": 0.04,
      "vignette": 0.10,
      "halation": 0.05,
      "lighting_arc": 0.24
    }
  },

  "scenes": [
    {
      "template": "title",
      "headline": "cua",
      "eyebrow": "computers for agents",
      "camera": "push_in",
      "duration_s": 3.0
    },
    {
      "template": "diagram",
      "eyebrow": "INSIDE A SANDBOX",
      "nodes": [
        {"label": "your agent", "x": 16, "y": 50},
        {"label": "cua", "x": 39, "y": 50, "accent": true, "filled": true},
        {"label": "sandbox VM", "x": 63, "y": 38},
        {"label": "live desktop", "x": 85, "y": 62}
      ],
      "edges": [
        {"from": 0, "to": 1, "accent": true},
        {"from": 1, "to": 2, "accent": true},
        {"from": 2, "to": 3, "accent": true}
      ],
      "camera": "orbit",
      "duration_s": 4.3
    },
    {
      "template": "fix",
      "primary": "A real computer.",
      "secondary": "fully sandboxed.",
      "emphasize": true,
      "camera": "crash_zoom",
      "duration_s": 3.3
    },
    {
      "template": "terminal",
      "title": "operator.py",
      "lines": [
        {"text": "computer = Computer(os='macos')", "prompt": true},
        {"text": "agent.run('file my expenses')", "prompt": true},
        {"text": "it clicks and types, not you", "prompt": false}
      ],
      "camera": "parallax_drift",
      "duration_s": 4.0
    },
    {
      "template": "big_number",
      "numeral": "3",
      "caption": "operating systems",
      "sub": "macOS, Linux and Windows",
      "camera": "ken_burns",
      "duration_s": 3.0
    },
    {
      "template": "close",
      "primary": "Stop clicking blind.",
      "accent": "give it a machine.",
      "subtitle": "the operator layer agents were missing.",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.4
    }
  ]
}
