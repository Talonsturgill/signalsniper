{
  "date": "2026-05-12",
  "topic": "OpenHuman, the agent with a memory you can grep",
  "creator_handle": "@senamakel",
  "project_url": "https://github.com/tinyhumansai/openhuman",

  "design": {
    "brand_slug": null,
    "aesthetic_slug": "geominimal",
    "framework": "SCHEMATIC",
    "audio_palette": "electronic",
    "held_subject": "openhuman",
    "tokens":   {"canvas": "#F5F5F0", "ink": "#0F0F10", "ink_muted": "#7E7E7E", "accent": "#DC4623", "hairline": "#E0E0DC"},
    "fonts":    {"display": "SpaceGrotesk", "body": "SpaceGrotesk", "italic": "SpaceGrotesk"},
    "typography": {"display_weight": 700, "body_weight": 400, "letter_spacing_em": -0.025, "case": "preserve", "italic_descriptors": false},
    "motion":   {"register": "cut", "scene_in_s": 0.06, "scene_out_s": 0.05, "stagger_s": 0.12},
    "layout":   {"padding_pct": 7, "rule_thickness_px": 2, "stage_radius_px": 0},
    "texture":  {"grain": 0.04, "vignette": 0.10, "halation": 0.0, "lighting_arc": 0.22},
    "accent_contrast_min": 3.5
  },

  "scenes": [
    {
      "template": "title",
      "headline": "OpenHuman",
      "eyebrow": "memory you can actually open",
      "camera": "push_in",
      "duration_s": 3.0
    },
    {
      "template": "diagram",
      "eyebrow": "the subconscious loop",
      "nodes": [
        {"label": "you",         "x": 50, "y": 16},
        {"label": "the agent",   "x": 50, "y": 50},
        {"label": "memory tree", "x": 22, "y": 82, "accent": true},
        {"label": "118 tools",   "x": 78, "y": 82}
      ],
      "edges": [
        {"from": 0, "to": 1},
        {"from": 1, "to": 2, "accent": true},
        {"from": 2, "to": 1, "accent": true, "style": "dashed"},
        {"from": 1, "to": 3}
      ],
      "camera": "orbit",
      "duration_s": 4.5
    },
    {
      "template": "two_line",
      "lines": ["most agents", "forget by morning."],
      "accent_idx": 1,
      "camera": "parallax_drift",
      "duration_s": 3.0
    },
    {
      "template": "fix",
      "primary": "yours. it stays.",
      "secondary": "and it gets sharper.",
      "emphasize": true,
      "camera": "push_in",
      "duration_s": 3.5
    },
    {
      "template": "close",
      "primary": "private. local.",
      "accent": "and growing.",
      "subtitle": "an agent that grows with you.",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.5
    }
  ]
}
