    "held_subject": "skills",
    "tokens":   {"canvas": "#1B1B1B", "ink": "#E0E0E0", "ink_muted": "#909090", "accent": "#FF3B30", "hairline": "#2A2A2A"},
    "fonts":    {"display": "JetBrainsMono", "body": "JetBrainsMono", "italic": "JetBrainsMono"},
    "typography": {"display_weight": 500, "body_weight": 400, "letter_spacing_em": 0.0, "case": "upper", "italic_descriptors": false},
    "motion":   {"register": "cut", "scene_in_s": 0.05, "scene_out_s": 0.05, "stagger_s": 0.08},
    "layout":   {"padding_pct": 5, "rule_thickness_px": 1, "stage_radius_px": 0},
    "texture":  {"grain": 0.10, "vignette": 0.30, "halation": 0.0, "lighting_arc": 0.10},
    "accent_contrast_min": 3.5
  },

  "scenes": [
    {
      "template": "title",
      "headline": "skills",
      "eyebrow": "from his .claude directory",
      "camera": "ken_burns",
      "duration_s": 3.0
    },
    {
      "template": "diagram",
      "eyebrow": "the inner loop",
      "nodes": [
        {"label": "intent",   "x": 50, "y": 16},
        {"label": "tdd loop", "x": 84, "y": 50},
        {"label": "diagnose", "x": 50, "y": 84, "accent": true},
        {"label": "zoom out", "x": 16, "y": 50}
      ],
      "edges": [
        {"from": 0, "to": 1},
        {"from": 1, "to": 2, "accent": true},
        {"from": 2, "to": 3},
        {"from": 3, "to": 0, "accent": true, "style": "dashed"}
      ],
      "camera": "orbit",
      "duration_s": 4.5
    },
    {
      "template": "two_line",
      "lines": ["agents drift fast.", "skills snap them back."],
      "accent_idx": 1,
      "camera": "parallax_drift",
      "duration_s": 3.0
    },
    {
      "template": "fix",
      "primary": "loop, not list.",
      "secondary": "compose, don't pile.",
      "emphasize": true,
      "camera": "push_in",
      "duration_s": 3.5
    },
    {
      "template": "close",
      "primary": "the loop wins.",
      "accent": "every time.",
      "subtitle": "matt pocock's .claude folder, public.",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.5
    }
  ]
