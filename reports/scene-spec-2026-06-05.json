{
  "date": "2026-06-05",
  "topic": "boxes.dev, the cloud agentic dev environment that gives every Claude Code and Codex agent its own real Linux machine instead of a worktree on your laptop",
  "creator_handle": "@nbushak",
  "project_url": "https://boxes.dev",

  "design": {
    "brand_slug": "linear.app",
    "aesthetic_slug": "linear.app",
    "framework": "SCHEMATIC",
    "audio_palette": "electronic",
    "held_subject": "boxes.dev",

    "tokens": {
      "canvas": "#010102",
      "ink": "#f7f8f8",
      "ink_muted": "#8a8f98",
      "accent": "#828fff",
      "hairline": "#23252a"
    },
    "fonts": {
      "display": "Inter",
      "body": "Inter",
      "italic": "Inter"
    },
    "typography": {
      "display_weight": 600,
      "body_weight": 400,
      "letter_spacing_em": -0.022,
      "case": "preserve",
      "italic_descriptors": false
    },
    "motion": {
      "register": "fade",
      "scene_in_s": 0.32,
      "scene_out_s": 0.22,
      "stagger_s": 0.20
    },
    "layout": {
      "padding_pct": 7,
      "rule_thickness_px": 1,
      "stage_radius_px": 12
    },
    "texture": {
      "grain": 0.05,
      "vignette": 0.20,
      "halation": 0.06,
      "lighting_arc": 0.26
    },
    "accent_contrast_min": 4.5
  },

  "scenes": [
    {
      "template": "title",
      "headline": "boxes.dev",
      "eyebrow": "one computer per agent",
      "camera": "orbit",
      "duration_s": 3.5
    },
    {
      "template": "diagram",
      "eyebrow": "each gets its own box",
      "nodes": [
        {"label": "localhost", "x": 16, "y": 50},
        {"label": "claude code", "x": 70, "y": 22},
        {"label": "codex", "x": 70, "y": 50},
        {"label": "agent n", "x": 70, "y": 78, "accent": true}
      ],
      "edges": [
        {"from": 0, "to": 1},
        {"from": 0, "to": 2},
        {"from": 0, "to": 3, "accent": true}
      ],
      "camera": "orbit",
      "duration_s": 4.5
    },
    {
      "template": "two_line",
      "lines": ["A real Linux box each.", "Your setup, preloaded."],
      "accent_idx": 0,
      "camera": "parallax_drift",
      "duration_s": 3.5
    },
    {
      "template": "fix",
      "primary": "Spin up. Fan out.",
      "secondary": "Nothing steps on toes.",
      "emphasize": true,
      "camera": "push_in",
      "duration_s": 4.0
    },
    {
      "template": "close",
      "primary": "Code from anywhere.",
      "accent": "Agents run remote.",
      "subtitle": "desktop and mobile, your own subscription.",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.5
    }
  ]
}
