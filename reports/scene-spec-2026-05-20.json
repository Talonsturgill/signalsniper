{
  "date": "2026-05-20",
  "topic": "code-review-graph, the local knowledge graph that lets AI coding agents read only the files an edit touches",
  "creator_handle": "@tirth_8205",
  "project_url": "https://github.com/tirth8205/code-review-graph",

  "design": {
    "brand_slug": "opencode.ai",
    "aesthetic_slug": "opencode.ai",
    "framework": "SCHEMATIC",
    "audio_palette": "acoustic",
    "accent_contrast_min": 4.5,

    "tokens": {
      "canvas": "#FDFCFC",
      "ink": "#201D1D",
      "ink_muted": "#646262",
      "accent": "#0056B3",
      "hairline": "#E0DAD9"
    },

    "fonts": {
      "display": "JetBrainsMono",
      "body": "JetBrainsMono",
      "italic": "JetBrainsMono"
    },

    "typography": {
      "display_weight": 700,
      "body_weight": 400,
      "letter_spacing_em": 0.0,
      "case": "preserve",
      "italic_descriptors": false
    },

    "motion": {
      "register": "cut",
      "scene_in_s": 0.10,
      "scene_out_s": 0.08,
      "stagger_s": 0.12
    },

    "layout": {
      "padding_pct": 7,
      "rule_thickness_px": 1,
      "stage_radius_px": 0
    },

    "texture": {
      "grain": 0.04,
      "vignette": 0.12,
      "halation": 0.0,
      "lighting_arc": 0.18
    },

    "held_subject": "code-review-graph"
  },

  "scenes": [
    {
      "template": "title",
      "headline": "code-review-graph",
      "eyebrow": "the file map every agent needs",
      "camera": "orbit",
      "duration_s": 3.4
    },
    {
      "template": "diagram",
      "eyebrow": "the structural slice",
      "nodes": [
        {"label": "your edit", "x": 50, "y": 22},
        {"label": "callers", "x": 22, "y": 50},
        {"label": "imports", "x": 78, "y": 50},
        {"label": "tests touched", "x": 50, "y": 78, "accent": true}
      ],
      "edges": [
        {"from": 0, "to": 1},
        {"from": 0, "to": 2},
        {"from": 1, "to": 3, "accent": true},
        {"from": 2, "to": 3, "accent": true}
      ],
      "camera": "orbit",
      "duration_s": 4.5
    },
    {
      "template": "two_line",
      "lines": [
        "27k files in repo.",
        "agent opens 15."
      ],
      "accent_idx": 1,
      "camera": "parallax_drift",
      "duration_s": 3.0
    },
    {
      "template": "fix",
      "primary": "blast radius.",
      "secondary": "the rest stays cold.",
      "emphasize": true,
      "camera": "push_in",
      "duration_s": 4.0
    },
    {
      "template": "close",
      "primary": "narrow the context.",
      "accent": "graph the diff.",
      "subtitle": "24 languages, 28 mcp tools, 100% local.",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 4.0
    }
  ]
}
