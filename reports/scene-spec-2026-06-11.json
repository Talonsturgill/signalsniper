{
  "date": "2026-06-11",
  "topic": "agentsview, local-first session intelligence for coding agents",
  "creator_handle": "@wesmckinn",
  "project_url": "https://github.com/kenn-io/agentsview",

  "design": {
    "brand_slug": null,
    "aesthetic_slug": "gallery",
    "framework": "SCHEMATIC",
    "audio_palette": "acoustic",
    "held_subject": "agentsview",
    "accent_contrast_min": 4.5,

    "tokens": {
      "canvas": "#FFFFFF",
      "ink": "#0E0E0F",
      "ink_muted": "#7B7B7E",
      "accent": "#1B5BFF",
      "hairline": "#E5E5E8"
    },
    "fonts": {
      "display": "IBMPlexSerif",
      "body": "Inter",
      "italic": "IBMPlexSerif"
    },
    "typography": {
      "display_weight": 700,
      "body_weight": 400,
      "letter_spacing_em": -0.018,
      "case": "preserve",
      "italic_descriptors": true
    },
    "motion": {
      "register": "fade",
      "scene_in_s": 0.42,
      "scene_out_s": 0.27,
      "stagger_s": 0.30
    },
    "layout": {
      "padding_pct": 9,
      "rule_thickness_px": 1,
      "stage_radius_px": 4
    },
    "texture": {
      "grain": 0.04,
      "vignette": 0.12,
      "halation": 0.05,
      "lighting_arc": 0.24
    }
  },

  "scenes": [
    {
      "template": "title",
      "headline": "agentsview",
      "eyebrow": "where agent sessions live",
      "camera": "push_in",
      "duration_s": 3.0
    },
    {
      "template": "diagram",
      "eyebrow": "EVERY AGENT, ONE INDEX",
      "nodes": [
        {"label": "agentsview", "x": 50, "y": 50, "accent": true, "filled": true},
        {"label": "Claude Code", "x": 20, "y": 24},
        {"label": "Codex", "x": 80, "y": 24},
        {"label": "Cursor", "x": 20, "y": 76},
        {"label": "Gemini CLI", "x": 80, "y": 76}
      ],
      "edges": [
        {"from": 1, "to": 0, "accent": true},
        {"from": 2, "to": 0, "accent": true},
        {"from": 3, "to": 0, "accent": true},
        {"from": 4, "to": 0, "accent": true}
      ],
      "camera": "orbit",
      "duration_s": 4.5
    },
    {
      "template": "two_line",
      "lines": ["Your history sits", "scattered by tool."],
      "accent_idx": 1,
      "camera": "parallax_drift",
      "duration_s": 2.8
    },
    {
      "template": "fix",
      "primary": "One local binary.",
      "secondary": "no accounts, no cloud.",
      "emphasize": true,
      "camera": "crash_zoom",
      "duration_s": 3.3
    },
    {
      "template": "big_number",
      "numeral": "100x",
      "caption": "faster than ccusage",
      "sub": "one file, twenty-plus agents",
      "camera": "ken_burns",
      "duration_s": 3.0
    },
    {
      "template": "close",
      "primary": "Own the whole trail.",
      "accent": "search it all.",
      "subtitle": "the dataframe instinct, aimed at agents.",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.4
    }
  ]
}
