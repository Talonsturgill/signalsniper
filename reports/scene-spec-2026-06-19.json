{
  "date": "2026-06-19",
  "topic": "Ollama, frontier open models running locally on Apple Silicon via the MLX engine",
  "creator_handle": "@ollama",
  "project_url": "https://github.com/ollama/ollama",

  "design": {
    "brand_slug": "ollama",
    "aesthetic_slug": "ollama",
    "framework": "SCHEMATIC",
    "audio_palette": "electronic",
    "held_subject": "ollama",

    "tokens": {
      "canvas": "#FFFFFF",
      "ink": "#000000",
      "ink_muted": "#737373",
      "accent": "#157F3C",
      "hairline": "#E5E5E5"
    },

    "fonts": {
      "display": "Inter",
      "body": "Inter",
      "italic": "Inter"
    },

    "typography": {
      "display_weight": 600,
      "body_weight": 400,
      "letter_spacing_em": 0,
      "case": "preserve",
      "italic_descriptors": false
    },

    "motion": {
      "register": "fade",
      "scene_in_s": 0.34,
      "scene_out_s": 0.22,
      "stagger_s": 0.22
    },

    "layout": {
      "padding_pct": 8,
      "rule_thickness_px": 1,
      "stage_radius_px": 12
    },

    "texture": {
      "grain": 0.04,
      "vignette": 0.10,
      "halation": 0.05,
      "lighting_arc": 0.24
    },

    "accent_contrast_min": 3.0
  },

  "scenes": [
    {
      "template": "title",
      "headline": "Ollama",
      "eyebrow": "run frontier models in private",
      "camera": "push_in",
      "duration_s": 3.0
    },
    {
      "template": "diagram",
      "eyebrow": "INSIDE THE MLX ENGINE",
      "nodes": [
        {"label": "Open model",   "x": 14, "y": 38},
        {"label": "MLX engine",   "x": 40, "y": 38, "accent": true, "filled": true},
        {"label": "Apple GPU",    "x": 66, "y": 38},
        {"label": "Local tokens", "x": 88, "y": 66, "accent": true}
      ],
      "edges": [
        {"from": 0, "to": 1},
        {"from": 1, "to": 2},
        {"from": 2, "to": 3, "accent": true}
      ],
      "camera": "orbit",
      "duration_s": 4.5
    },
    {
      "template": "terminal",
      "title": "ollama run command-a",
      "lines": [
        {"text": "ollama run command-a", "prompt": true},
        {"text": "loading weights into unified memory", "prompt": false},
        {"text": "ready  112 tok/s on this Mac", "prompt": false},
        {"text": "weights never leave the disk", "prompt": false}
      ],
      "accent_idx": 2,
      "camera": "parallax_drift",
      "duration_s": 3.5
    },
    {
      "template": "two_line",
      "lines": ["Cloud ships your data.", "This keeps it home."],
      "accent_idx": 1,
      "camera": "ken_burns",
      "duration_s": 3.0
    },
    {
      "template": "fix",
      "primary": "Local by default.",
      "secondary": "The Mac does the work.",
      "emphasize": true,
      "camera": "push_in",
      "duration_s": 3.0
    },
    {
      "template": "close",
      "primary": "Open weights.",
      "accent": "Closed doors.",
      "subtitle": "the model runs where you do",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.5
    }
  ]
}
