{
  "date": "2026-05-22",
  "topic": "autoresearch, an autonomous-research loop on a single GPU",
  "creator_handle": "@karpathy",
  "project_url": "https://github.com/karpathy/autoresearch",

  "design": {
    "brand_slug": null,
    "aesthetic_slug": "subway-chrome",
    "framework": "RECEIPT",
    "audio_palette": "electronic",
    "held_subject": "autoresearch",

    "tokens": {
      "canvas":    "#15171A",
      "ink":       "#F4F6FA",
      "ink_muted": "#8B95A6",
      "accent":    "#7DD9FF",
      "hairline":  "#262A30"
    },

    "fonts": {
      "display": "JetBrainsMono",
      "body":    "Inter",
      "italic":  "Inter"
    },

    "typography": {
      "display_weight":      600,
      "body_weight":         400,
      "letter_spacing_em":  -0.015,
      "case":               "preserve",
      "italic_descriptors": false
    },

    "motion": {
      "register":    "fade",
      "scene_in_s":  0.32,
      "scene_out_s": 0.22,
      "stagger_s":   0.22
    },

    "layout": {
      "padding_pct":       7,
      "rule_thickness_px": 1,
      "stage_radius_px":   4
    },

    "texture": {
      "grain":        0.04,
      "vignette":     0.20,
      "halation":     0.04,
      "lighting_arc": 0.32
    },

    "accent_contrast_min": 4.5
  },

  "scenes": [
    {
      "template": "title",
      "headline": "autoresearch",
      "eyebrow":  "agents drive the experiments",
      "camera":   "push_in",
      "duration_s": 3.0
    },
    {
      "template": "big_number",
      "numeral":  "100",
      "caption":  "experiments per overnight run",
      "sub":      "one GPU and one Python file",
      "camera":   "ken_burns",
      "duration_s": 3.5
    },
    {
      "template": "big_number",
      "numeral":  "5 min",
      "caption":  "fixed budget per attempt",
      "sub":      "score by val_bpb, drop the losses",
      "camera":   "orbit",
      "duration_s": 3.5
    },
    {
      "template":  "fix",
      "primary":   "ML research",
      "secondary": "runs in a loop.",
      "emphasize": true,
      "camera":    "push_in",
      "duration_s": 3.5
    },
    {
      "template":  "close",
      "primary":   "The night shift",
      "accent":    "is automated now.",
      "subtitle":  "no humans in the cycle.",
      "emphasize": true,
      "camera":    "pull_back",
      "duration_s": 3.5
    }
  ]
}
