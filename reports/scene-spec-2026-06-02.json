{
  "date": "2026-06-02",
  "topic": "Scrapling, the adaptive web-scraping framework that re-finds your elements when a site's HTML changes",
  "creator_handle": "@D4Vinci1",
  "project_url": "https://github.com/D4Vinci/Scrapling",

  "design": {
    "brand_slug": "clickhouse",
    "aesthetic_slug": "clickhouse",
    "framework": "SCHEMATIC",
    "audio_palette": "electronic",
    "held_subject": "Scrapling",

    "tokens": {
      "canvas": "#0a0a0a",
      "ink": "#ffffff",
      "ink_muted": "#9a9a9a",
      "accent": "#faff69",
      "hairline": "#2a2a2a"
    },
    "fonts": {
      "display": "Inter",
      "body": "Inter",
      "italic": "Inter"
    },
    "typography": {
      "display_weight": 700,
      "body_weight": 400,
      "letter_spacing_em": -0.022,
      "case": "preserve",
      "italic_descriptors": false
    },
    "motion": {
      "register": "fade",
      "scene_in_s": 0.30,
      "scene_out_s": 0.20,
      "stagger_s": 0.20
    },
    "layout": {
      "padding_pct": 7,
      "rule_thickness_px": 1,
      "stage_radius_px": 12
    },
    "texture": {
      "grain": 0.04,
      "vignette": 0.20,
      "halation": 0.06,
      "lighting_arc": 0.28
    },
    "accent_contrast_min": 4.5
  },

  "scenes": [
    {
      "template": "title",
      "headline": "Scrapling",
      "eyebrow": "the scraper that heals itself",
      "camera": "orbit",
      "duration_s": 3.5
    },
    {
      "template": "diagram",
      "eyebrow": "the page just changed",
      "nodes": [
        {"label": "saved element", "x": 16, "y": 50},
        {"label": "site redesign", "x": 44, "y": 50},
        {"label": "similarity match", "x": 72, "y": 50},
        {"label": "found again", "x": 92, "y": 50, "accent": true}
      ],
      "edges": [
        {"from": 0, "to": 1},
        {"from": 1, "to": 2},
        {"from": 2, "to": 3, "accent": true}
      ],
      "camera": "orbit",
      "duration_s": 4.5
    },
    {
      "template": "big_number",
      "numeral": "1600x",
      "caption": "faster than BeautifulSoup",
      "sub": "and it survives the redesign",
      "camera": "ken_burns",
      "duration_s": 3.5
    },
    {
      "template": "fix",
      "primary": "Selectors break.",
      "secondary": "Scrapling re-finds it.",
      "emphasize": true,
      "camera": "push_in",
      "duration_s": 4.0
    },
    {
      "template": "close",
      "primary": "Write it once.",
      "accent": "It keeps running.",
      "subtitle": "the web moves, your scraper doesn't break.",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.5
    }
  ]
}
