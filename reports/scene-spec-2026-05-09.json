{
  "date": "2026-05-09",
  "topic": "pi-mono, the anti-framework agent toolkit",
  "creator_handle": "@badlogicgames",
  "project_url": "https://github.com/badlogic/pi-mono",

  "design": {
    "brand_slug": null,
    "aesthetic_slug": "mono-terminal",
    "framework": "CLASSIC",
    "held_subject": "pi-mono",
    "audio_palette": "electronic",
    "accent_contrast_min": 4.5,

    "tokens": {
      "canvas": "#0A0A0A",
      "ink": "#F0F0F0",
      "ink_muted": "#7A7A7A",
      "accent": "#37F712",
      "hairline": "#1F1F1F"
    },

    "fonts": {
      "display": "JetBrainsMono",
      "body": "JetBrainsMono",
      "italic": "JetBrainsMono"
    },

    "typography": {
      "display_weight": 600,
      "body_weight": 400,
      "letter_spacing_em": -0.005,
      "case": "lower",
      "italic_descriptors": false
    },

    "motion": {
      "register": "cut",
      "scene_in_s": 0.06,
      "scene_out_s": 0.05,
      "stagger_s": 0.10
    },

    "layout": {
      "padding_pct": 6,
      "rule_thickness_px": 1,
      "stage_radius_px": 0
    },

    "texture": {
      "grain": 0.05,
      "vignette": 0.22,
      "halation": 0.0,
      "lighting_arc": 0.18
    }
  },

  "scenes": [
    {
      "template": "title",
      "headline": "pi-mono",
      "eyebrow": "agent toolkit, minus the framework",
      "camera": "push_in",
      "duration_s": 3.0
    },
    {
      "template": "stack",
      "eyebrow": "THE STACK",
      "items": [
        {"name": "coding cli",  "descriptor": "terminal harness"},
        {"name": "llm router",  "descriptor": "one api, fifteen llms"},
        {"name": "vllm pods",   "descriptor": "self-host the model"}
      ],
      "camera": "static_breathe",
      "duration_s": 3.5
    },
    {
      "template": "two_line",
      "lines": ["most agent kits", "ship a framework."],
      "accent_idx": 1,
      "camera": "parallax_drift",
      "duration_s": 3.0
    },
    {
      "template": "fix",
      "primary": "minimal core.",
      "secondary": "you wire the rest.",
      "emphasize": true,
      "camera": "push_in",
      "duration_s": 3.5
    },
    {
      "template": "three_line",
      "lines": ["one api.", "fifteen providers.", "zero opinions."],
      "accent_idx": 2,
      "camera": "ken_burns",
      "duration_s": 3.5
    },
    {
      "template": "close",
      "primary": "minimal core.",
      "accent": "you wire it.",
      "subtitle": "the part most kits skip.",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.5
    }
  ]
}
