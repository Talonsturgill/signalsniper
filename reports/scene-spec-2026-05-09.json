{
  "date": "2026-05-09",
  "topic": "ProofShot, eyes for AI coding agents",
  "creator_handle": "@JBerthom",
  "project_url": "https://github.com/AmElmo/proofshot",

  "design": {
    "brand_slug": null,
    "aesthetic_slug": "gallery",
    "framework": "CLASSIC",
    "audio_palette": "ambient",
    "held_subject": "proofshot",
    "tokens":   {"canvas": "#FFFFFF", "ink": "#0E0E0F", "ink_muted": "#7B7B7E", "accent": "#1B5BFF", "hairline": "#E5E5E8"},
    "fonts":    {"display": "IBMPlexSerif", "body": "Inter", "italic": "IBMPlexSerif"},
    "typography": {"display_weight": 700, "body_weight": 400, "letter_spacing_em": -0.018, "case": "preserve", "italic_descriptors": true},
    "motion":   {"register": "fade", "scene_in_s": 0.42, "scene_out_s": 0.27, "stagger_s": 0.30},
    "layout":   {"padding_pct": 9, "rule_thickness_px": 1, "stage_radius_px": 4},
    "texture":  {"grain": 0.03, "vignette": 0.10, "halation": 0.04, "lighting_arc": 0.22},
    "accent_contrast_min": 4.5
  },

  "scenes": [
    {
      "template": "title",
      "headline": "ProofShot",
      "eyebrow": "eyes for coding agents",
      "camera": "orbit",
      "duration_s": 3.0
    },
    {
      "template": "terminal",
      "title": "$ proofshot install",
      "lines": [
        "> recording session for /onboarding",
        "> 14 frames written",
        "> 2 console errors flagged",
        "> proof.html bundle ready"
      ],
      "camera": "static_breathe",
      "duration_s": 4.0
    },
    {
      "template": "two_line",
      "lines": ["AI coders build UI", "without seeing it."],
      "accent_idx": 1,
      "camera": "parallax_drift",
      "duration_s": 3.0
    },
    {
      "template": "fix",
      "primary": "Now they look.",
      "secondary": "before you trust.",
      "emphasize": true,
      "camera": "push_in",
      "duration_s": 4.0
    },
    {
      "template": "three_line",
      "lines": ["the run, on video.", "the bugs, on the wall.", "the proof, in the PR."],
      "accent_idx": 2,
      "camera": "ken_burns",
      "duration_s": 3.5
    },
    {
      "template": "close",
      "primary": "Coders, with eyes.",
      "accent": "and receipts.",
      "subtitle": "verification for any agent.",
      "emphasize": true,
      "camera": "pull_back",
      "duration_s": 3.5
    }
  ]
}
