    },
    {
      "template": "big_number",
      "numeral": "92%",
      "caption": "fewer tokens than built-in memory.",
      "sub": "ten dollars a year, not five hundred.",
      "camera": "ken_burns",
      "duration_s": 3.5
    },
    {
      "template": "diagram",
      "eyebrow": "TRIPLE STREAM",
      "nodes": [
        {"label": "BM25",            "x": 18, "y": 30},
        {"label": "vectors",         "x": 50, "y": 18},
        {"label": "knowledge graph", "x": 82, "y": 30},
