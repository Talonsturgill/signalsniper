    {"template": "fix", "primary": "the signal sees.", "secondary": "just an esp32 chip.", "emphasize": true, "camera": "push_in", "duration_s": 3.3},
    {"template": "close", "primary": "sense, not surveil.", "accent": "built in the open.", "subtitle": "awareness without a watcher.", "emphasize": true, "camera": "pull_back", "duration_s": 3.5}
